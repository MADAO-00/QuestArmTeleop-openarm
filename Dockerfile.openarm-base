# Independent Ubuntu 22.04 / ROS 2 Humble dependency image. Build through
# run_openarm_v1.sh so the hardware image records this image's immutable ID.
ARG OPENARM_ROS_IMAGE=ros:humble-ros-base-jammy
FROM ${OPENARM_ROS_IMAGE}

ARG OPENARM_PIP_INDEX_URL=https://pypi.org/simple
ENV ROS_DISTRO=humble \
    OPENARM_VT_PYTHON=/root/miniforge3/envs/vt/bin/python \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.questarm.openarm-base.schema="questarm-openarm-base-humble-v1"
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install the dependencies for ros2_control and the optional RViz display.
# The upstream MoveIt configuration is built for its description files, but
# MoveIt, Gazebo, camera drivers and Piper software are not runtime dependencies.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      adb \
      build-essential \
      ca-certificates \
      can-utils \
      cmake \
      ethtool \
      git \
      iproute2 \
      kmod \
      libcli11-dev \
      libegl1 \
      libgl1 \
      libglfw3 \
      libosmesa6 \
      nlohmann-json3-dev \
      pkg-config \
      python3-colcon-common-extensions \
      python3-dev \
      python3-numpy \
      python3-pip \
      python3-pytest \
      python3-scipy \
      python3-vcstool \
      python3-venv \
      python3-yaml \
      ros-humble-ament-cmake \
      ros-humble-ament-cmake-pytest \
      ros-humble-ament-cmake-python \
      ros-humble-controller-manager \
      ros-humble-forward-command-controller \
      ros-humble-hardware-interface \
      ros-humble-joint-state-broadcaster \
      ros-humble-joint-state-publisher \
      ros-humble-launch-ros \
      ros-humble-pluginlib \
      ros-humble-rclcpp \
      ros-humble-rclcpp-lifecycle \
      ros-humble-rclpy \
      ros-humble-robot-state-publisher \
      ros-humble-ros2controlcli \
      ros-humble-rosidl-default-generators \
      ros-humble-rviz2 \
      ros-humble-tf2-ros \
      ros-humble-xacro \
 && rm -rf /var/lib/apt/lists/*

# Retain the reviewed launch interpreter path without depending on Conda or a
# private prebuilt image. System site packages expose apt-managed ROS helpers;
# pinned pip wheels live in the venv and never replace /usr/bin/python3 packages.
COPY requirements.txt /tmp/openarm-base-requirements.txt
RUN /usr/bin/python3 -c 'import sys; assert sys.version_info[:2] == (3, 10)' \
 && /usr/bin/python3 -m venv --system-site-packages /root/miniforge3/envs/vt \
 && "${OPENARM_VT_PYTHON}" -m pip install --no-cache-dir \
      --index-url "${OPENARM_PIP_INDEX_URL}" \
      -r /tmp/openarm-base-requirements.txt \
 && source /opt/ros/humble/setup.bash \
 && "${OPENARM_VT_PYTHON}" -c \
      'import rclpy, numpy, scipy, yaml; from ppadb.client import Client; from tf2_ros import TransformBroadcaster; assert numpy.__version__ == "2.2.6"; assert scipy.__version__ == "1.15.2"' \
 && /usr/bin/python3 -c 'import rclpy, numpy, scipy, yaml, pytest' \
 && mkdir -p /opt/questarm \
 && printf '%s\n' 'questarm-openarm-base-humble-v1' > /opt/questarm/openarm-base.schema \
 && chmod 0444 /opt/questarm/openarm-base.schema \
 && rm /tmp/openarm-base-requirements.txt

WORKDIR /workspace
ENTRYPOINT []
CMD ["/bin/bash"]
