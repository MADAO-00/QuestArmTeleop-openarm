+bool OpenArmHW::verify_gripper_mit_mode_ack() {
+  if (!hand_) {
+    return true;
+  }
+  const auto gripper_motors = openarm_->get_gripper().get_motors();
+  if (gripper_motors.size() != 1) {
+    return false;
+  }
+
+  const int control_mode_rid =
+      static_cast<int>(openarm::damiao_motor::RID::CTRL_MODE);
+  // init_gripper_motor() creates a new Motor with an empty parameter map, then
+  // emits exactly one CTRL_MODE write while its callback is in PARAM mode. A
+  // non-sentinel value observed after this point is therefore the write ACK;
+  // the upstream API exposes no parameter-response generation counter.
+  if (gripper_motors.front().get_param(control_mode_rid) != -1.0) {
+    RCLCPP_ERROR(rclcpp::get_logger("OpenArmHW"),
+                 "Gripper CTRL_MODE parameter was unexpectedly populated "
+                 "before acknowledgement receive");
+    return false;
+  }
+
+  const double expected_mode = static_cast<double>(
+      static_cast<int>(openarm::damiao_motor::ControlMode::MIT));
+  const auto deadline =
+      std::chrono::steady_clock::now() + GRIPPER_MODE_ACK_TIMEOUT;
+  while (std::chrono::steady_clock::now() < deadline) {
+    openarm_->recv_all(FEEDBACK_RECV_SLICE_US);
+    const auto after = openarm_->get_gripper().get_motors();
+    if (after.size() != 1) {
+      return false;
+    }
+    const double acknowledged_mode =
+        after.front().get_param(control_mode_rid);
+    if (acknowledged_mode == -1.0) {
+      continue;
+    }
+    if (!std::isfinite(acknowledged_mode) ||
+        acknowledged_mode != expected_mode) {
+      RCLCPP_ERROR(rclcpp::get_logger("OpenArmHW"),
+                   "Gripper CTRL_MODE acknowledgement was %.6f, expected "
+                   "MIT mode %.0f",
+                   acknowledged_mode, expected_mode);
+      return false;
+    }
+    RCLCPP_INFO(rclcpp::get_logger("OpenArmHW"),
+                "Verified gripper CTRL_MODE=MIT acknowledgement");
+    return true;
   }
+
+  RCLCPP_ERROR(rclcpp::get_logger("OpenArmHW"),
+               "Timed out waiting for gripper CTRL_MODE=MIT acknowledgement");
   return false;
 }
 
