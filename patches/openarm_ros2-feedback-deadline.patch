+bool OpenArmHW::seed_runtime_feedback_watchdog() {
+  runtime_feedback_watchdog_seeded_ = false;
+  const auto arm_motors = openarm_->get_arm().get_motors();
+  const auto gripper_motors =
+      hand_ ? openarm_->get_gripper().get_motors()
+            : std::vector<openarm::damiao_motor::Motor>{};
+  if (arm_motors.size() != ARM_DOF ||
+      (hand_ && gripper_motors.size() != 1)) {
+    return false;
+  }
+
+  const auto now = std::chrono::steady_clock::now();
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    runtime_feedback_counts_[i] = arm_motors[i].state_update_count();
+    runtime_feedback_times_[i] = now;
+  }
+  if (hand_) {
+    runtime_gripper_feedback_count_ =
+        gripper_motors.front().state_update_count();
+    runtime_gripper_feedback_time_ = now;
+  }
+  runtime_feedback_watchdog_seeded_ = true;
+  return true;
+}
