+bool OpenArmHW::collect_runtime_feedback() {
+  if (!runtime_feedback_watchdog_seeded_) {
+    RCLCPP_ERROR(rclcpp::get_logger("OpenArmHW"),
+                 "Runtime feedback watchdog was not seeded");
+    return false;
+  }
+
+  // Runtime is a pipeline: write() sends one MIT command per motor and those
+  // replies advance the counters. A single nonblocking drain here consumes any
+  // tail frames without adding a per-arm blocking transaction to the 750 Hz
+  // loop. Missing updates are tolerated only up to the small age watchdog.
+  openarm_->recv_all(0);
+  const auto arm_motors = openarm_->get_arm().get_motors();
+  const auto gripper_motors =
+      hand_ ? openarm_->get_gripper().get_motors()
+            : std::vector<openarm::damiao_motor::Motor>{};
+  if (arm_motors.size() != ARM_DOF ||
+      (hand_ && gripper_motors.size() != 1)) {
+    RCLCPP_ERROR(rclcpp::get_logger("OpenArmHW"),
+                 "Malformed runtime feedback: arm=%zu gripper=%zu",
+                 arm_motors.size(), gripper_motors.size());
+    return false;
+  }
+
+  const auto now = std::chrono::steady_clock::now();
+  auto next_counts = runtime_feedback_counts_;
+  auto next_times = runtime_feedback_times_;
+  std::array<bool, ARM_DOF> fresh{};
+  std::array<double, ARM_DOF> age_ms{};
+  bool valid = true;
+
+  auto feedback_values_valid = [](const openarm::damiao_motor::Motor& motor,
+                                  double max_abs_torque) {
+    return motor.get_status() == 1 && std::isfinite(motor.get_position()) &&
+           std::isfinite(motor.get_velocity()) &&
+           std::isfinite(motor.get_torque()) &&
+           std::abs(motor.get_velocity()) <= MAX_ABS_FEEDBACK_VELOCITY &&
+           std::abs(motor.get_torque()) <= max_abs_torque &&
+           motor.get_state_tmos() >= 0 &&
+           motor.get_state_tmos() <= MAX_FEEDBACK_TEMPERATURE &&
+           motor.get_state_trotor() >= 0 &&
+           motor.get_state_trotor() <= MAX_FEEDBACK_TEMPERATURE;
+  };
+
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    const auto count = arm_motors[i].state_update_count();
+    if (count != runtime_feedback_counts_[i]) {
+      fresh[i] = true;
+      next_counts[i] = count;
+      next_times[i] = now;
+    }
+    age_ms[i] = std::chrono::duration<double, std::milli>(now - next_times[i]).count();
+    if (!feedback_values_valid(arm_motors[i], MAX_ABS_FEEDBACK_TORQUE[i]) ||
