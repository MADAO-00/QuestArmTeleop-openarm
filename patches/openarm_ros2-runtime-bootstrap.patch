+bool OpenArmHW::bootstrap_runtime_feedback() {
+  // ros2_control activates multiple hardware components serially, then starts
+  // its read-update-write loop. Re-establish a causal, non-motion feedback
+  // boundary on the first read so another arm's activation latency cannot age
+  // this arm's activation sample past the strict runtime watchdog deadline.
+  if (!run_feedback_transaction(
+          1, "runtime feedback bootstrap", ACTIVATION_FEEDBACK_TIMEOUT,
+          [this]() { openarm_->refresh_all(); })) {
+    return false;
+  }
+  if (!seed_commands_from_feedback()) {
+    return false;
+  }
+  if (!seed_runtime_feedback_watchdog()) {
+    return false;
+  }
+  runtime_feedback_bootstrap_pending_ = false;
+  RCLCPP_INFO(rclcpp::get_logger("OpenArmHW"),
+              "Fresh runtime feedback bootstrap passed");
+  return true;
+}
