+bool OpenArmHW::seed_commands_from_feedback() {
+  command_gate_seeded_ = false;
+  const auto arm_motors = openarm_->get_arm().get_motors();
+  if (arm_motors.size() != ARM_DOF || pos_commands_.size() != joint_names_.size()) {
+    return false;
+  }
+  const auto& lower_limits = arm_prefix_ == "left_"
+                                 ? LEFT_LOWER_POSITION_LIMITS
+                                 : RIGHT_LOWER_POSITION_LIMITS;
+  const auto& upper_limits = arm_prefix_ == "left_"
+                                 ? LEFT_UPPER_POSITION_LIMITS
+                                 : RIGHT_UPPER_POSITION_LIMITS;
+
+  for (size_t i = 0; i < ARM_DOF; ++i) {
+    const double position = arm_motors[i].get_position();
+    const double velocity = arm_motors[i].get_velocity();
+    const double torque = arm_motors[i].get_torque();
+    if (!std::isfinite(position) || !std::isfinite(velocity) ||
+        !std::isfinite(torque) || position < lower_limits[i] ||
+        position > upper_limits[i]) {
+      return false;
+    }
+    pos_states_[i] = position;
+    vel_states_[i] = velocity;
+    tau_states_[i] = torque;
+    pos_commands_[i] = position;
+    vel_commands_[i] = 0.0;
+    tau_commands_[i] = 0.0;
+    last_accepted_positions_[i] = position;
+    position_tokens_[i] =
+        MAX_COMMAND_VELOCITY[i] * POSITION_TOKEN_BURST_SECONDS;
+  }
+
+  if (hand_) {
+    const auto gripper_motors = openarm_->get_gripper().get_motors();
+    if (gripper_motors.size() != 1 || joint_names_.size() != ARM_DOF + 1) {
+      return false;
+    }
+    const double motor_position = gripper_motors.front().get_position();
+    const double joint_position = motor_radians_to_joint(motor_position);
+    if (!std::isfinite(joint_position)) {
+      return false;
+    }
+    pos_states_[ARM_DOF] = joint_position;
+    vel_states_[ARM_DOF] = 0.0;
+    tau_states_[ARM_DOF] = 0.0;
+    pos_commands_[ARM_DOF] = joint_position;
+    vel_commands_[ARM_DOF] = 0.0;
+    tau_commands_[ARM_DOF] = 0.0;
+  }
+
+  command_gate_seeded_ = true;
+  return true;
+}
