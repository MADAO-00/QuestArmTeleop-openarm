+void OpenArmHW::best_effort_disable() noexcept {
+  try {
+    openarm_->set_callback_mode_all(openarm::damiao_motor::CallbackMode::STATE);
+    for (int attempt = 0; attempt < FEEDBACK_ATTEMPTS; ++attempt) {
+      openarm_->disable_all();
+      openarm_->recv_all(FEEDBACK_TIMEOUT_US);
+    }
+  } catch (const std::exception& exception) {
+    RCLCPP_ERROR(rclcpp::get_logger("OpenArmHW"),
+                 "Fail-safe disable raised an exception: %s", exception.what());
+  } catch (...) {
+    RCLCPP_ERROR(rclcpp::get_logger("OpenArmHW"),
+                 "Fail-safe disable raised an unknown exception");
+  }
+}
