+bool OpenArmHW::wait_for_fresh_feedback(bool expected_enabled,
+                                        const char* phase) {
+  // Keep one baseline across bounded retries so replies that arrive in
+  // separate socket drains still count toward one complete fresh sample.
+  const auto arm_before = openarm_->get_arm().get_motors();
+  const auto gripper_before =
+      hand_ ? openarm_->get_gripper().get_motors()
+            : std::vector<openarm::damiao_motor::Motor>{};
+
+  for (int attempt = 1; attempt <= FEEDBACK_ATTEMPTS; ++attempt) {
+    openarm_->refresh_all();
+    openarm_->recv_all(FEEDBACK_TIMEOUT_US);
+
+    const auto arm_after = openarm_->get_arm().get_motors();
+    const auto gripper_after =
+        hand_ ? openarm_->get_gripper().get_motors()
+              : std::vector<openarm::damiao_motor::Motor>{};
+
+    bool valid = arm_before.size() == ARM_DOF && arm_after.size() == ARM_DOF;
+    if (hand_) {
+      valid = valid && gripper_before.size() == 1 && gripper_after.size() == 1;
+    }
+
+    auto validate_motor = [&](const openarm::damiao_motor::Motor& before,
+                              const openarm::damiao_motor::Motor& after,
+                              double max_abs_torque) {
+      return after.state_update_count() > before.state_update_count() &&
+             std::isfinite(after.get_position()) &&
+             std::isfinite(after.get_velocity()) &&
+             std::isfinite(after.get_torque()) &&
+             std::abs(after.get_velocity()) <= MAX_ABS_FEEDBACK_VELOCITY &&
+             std::abs(after.get_torque()) <= max_abs_torque &&
+             after.get_state_tmos() >= 0 &&
+             after.get_state_tmos() <= MAX_FEEDBACK_TEMPERATURE &&
+             after.get_state_trotor() >= 0 &&
+             after.get_state_trotor() <= MAX_FEEDBACK_TEMPERATURE &&
+             after.is_enabled() == expected_enabled;
+    };
+
+    if (valid) {
+      for (size_t i = 0; i < ARM_DOF; ++i) {
+        if (!validate_motor(arm_before[i], arm_after[i],
+                            MAX_ABS_FEEDBACK_TORQUE[i])) {
+          valid = false;
+          break;
+        }
+      }
+    }
+    if (valid && hand_ &&
+        !validate_motor(gripper_before.front(), gripper_after.front(),
+                        MAX_ABS_GRIPPER_FEEDBACK_TORQUE)) {
+      valid = false;
+    }
+
+    if (valid) {
+      return true;
+    }
+
+    RCLCPP_WARN(rclcpp::get_logger("OpenArmHW"),
+                "Fresh %s feedback validation failed during %s "
+                "(attempt %d/%d)",
+                expected_enabled ? "enabled" : "disabled", phase, attempt,
+                FEEDBACK_ATTEMPTS);
+  }
+
+  return false;
+}
