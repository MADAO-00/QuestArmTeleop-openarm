+namespace {
+template <typename Operation>
+void apply_to_all_collections(
+    const std::vector<damiao_motor::DMDeviceCollection*>& device_collections,
+    Operation operation) {
+    std::exception_ptr first_error;
+    for (damiao_motor::DMDeviceCollection* device_collection : device_collections) {
+        try {
+            operation(*device_collection);
+        } catch (...) {
+            if (!first_error) first_error = std::current_exception();
+        }
+    }
+    if (first_error) std::rethrow_exception(first_error);
+}
